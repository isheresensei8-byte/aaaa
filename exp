================================================================================
  SECTION 4 — TIC-TAC-TOE USING MINIMAX
================================================================================
  What it does:
    A playable Tic-Tac-Toe game where the AI plays as X and the human plays
    as O. The AI uses Minimax to always make the optimal move.

  Functions:
    - print_board(): Displays the 3x3 board in the console.
    - check_winner(b): Checks all rows, columns, and diagonals for a winner.
      Returns 'X', 'O', or None.
    - is_full(b): Returns True if no empty cells remain (draw condition).
    - minimax(b, is_max): Recursively evaluates all possible game states.
      Returns +1 if X wins, -1 if O wins, 0 for draw.
    - best_move(): Iterates all empty cells, simulates each move, picks the
      cell with the highest minimax score.
  
  Game Loop:
    - Human enters row and column (0-2).
    - AI responds with its best calculated move.
    - Game ends when there's a winner or the board is full.
--------------------------------------------------------------------------------

import math

board = [[" " for _ in range(3)] for _ in range(3)]

def print_board():
    for row in board:
        print("|".join(row))
        print("-"*5)

def check_winner(b):
    for i in range(3):
        if b[i][0] == b[i][1] == b[i][2] != " ":
            return b[i][0]
        if b[0][i] == b[1][i] == b[2][i] != " ":
            return b[0][i]
    if b[0][0] == b[1][1] == b[2][2] != " ":
        return b[0][0]
    if b[0][2] == b[1][1] == b[2][0] != " ":
        return b[0][2]
    return None

def is_full(b):
    return all(b[i][j] != " " for i in range(3) for j in range(3))

def minimax(b, is_max):
    winner = check_winner(b)
    if winner == "X": return 1
    if winner == "O": return -1
    if is_full(b): return 0

    if is_max:
        best = -math.inf
        for i in range(3):
            for j in range(3):
                if b[i][j] == " ":
                    b[i][j] = "X"
                    best = max(best, minimax(b, False))
                    b[i][j] = " "
        return best
    else:
        best = math.inf
        for i in range(3):
            for j in range(3):
                if b[i][j] == " ":
                    b[i][j] = "O"
                    best = min(best, minimax(b, True))
                    b[i][j] = " "
        return best

def best_move():
    best_val = -math.inf
    move = (-1, -1)
    for i in range(3):
        for j in range(3):
            if board[i][j] == " ":
                board[i][j] = "X"
                val = minimax(board, False)
                board[i][j] = " "
                if val > best_val:
                    best_val = val
                    move = (i, j)
    return move

while True:
    print_board()
    try:
        r, c = map(int, input("Enter row col (0-2): ").split())
    except ValueError: continue
    if board[r][c] != " ":
        print("Invalid move!")
        continue
    board[r][c] = "O"
    if check_winner(board) or is_full(board): break
    ai_r, ai_c = best_move()
    board[ai_r][ai_c] = "X"
    if check_winner(board) or is_full(board): break

print_board()
winner = check_winner(board)
print("Winner:", winner if winner else "Draw")


================================================================================
  SECTION 5 — OPTIMAL COIN-PICK STRATEGY GAME (MINIMAX)
================================================================================
  What it does:
    Two players (Max and Min) take turns picking coins from either end of a
    row. Max wants to maximize their total score; Min wants to minimize it.
    Uses Minimax recursion to find the theoretically optimal play for both.

  Functions:
    - minimax(coins, i, j, is_max): Returns the best score achievable for the
      current player from coins[i..j]. At MAX turn, picks the max of taking
      left or right; at MIN turn, picks the minimum.
    - play_game(coins): Simulates the game step-by-step, showing which coin
      each player picks and the remaining coins after each turn.
--------------------------------------------------------------------------------

import math

def minimax(coins, i, j, is_max):
    if i > j:
        return 0
    if is_max:
        return max(
            coins[i] + minimax(coins, i+1, j, False),
            coins[j] + minimax(coins, i, j-1, False)
        )
    else:
        return min(
            minimax(coins, i+1, j, True),
            minimax(coins, i, j-1, True)
        )

def play_game(coins):
    i, j = 0, len(coins) - 1
    max_score = 0; min_score = 0
    is_max = True
    print("Initial Coins:", coins)

    while i <= j:
        if is_max:
            left = coins[i] + minimax(coins, i+1, j, False)
            right = coins[j] + minimax(coins, i, j-1, False)
            if left >= right:
                pick = coins[i]; i += 1
            else:
                pick = coins[j]; j -= 1
            max_score += pick
            print(f"Max picks {pick}, Remaining Coins: {coins[i:j+1]}")
        else:
            left = minimax(coins, i+1, j, True)
            right = minimax(coins, i, j-1, True)
            if left <= right:
                pick = coins[i]; i += 1
            else:
                pick = coins[j]; j -= 1
            min_score += pick
            print(f"Min picks {pick}, Remaining Coins: {coins[i:j+1]}")
        is_max = not is_max

    print(f"\nFinal Scores - Max: {max_score}, Min: {min_score}")
    if max_score > min_score: print("Winner: Max")
    elif min_score > max_score: print("Winner: Min")
    else: print("Draw")

coins = [3, 9, 1, 2, 7, 5]
play_game(coins)


================================================================================
  SECTION 6 — WORD SCRABBLE GAME (MINIMAX + MEMOIZATION)
================================================================================
  What it does:
    Two players take turns picking letters from a pool to form a word.
    Max wants to form a dictionary word (positive score = word length),
    Min wants to avoid it (penalty = -2 for invalid words). Memoization
    prevents recomputing the same state twice.

  Functions:
    - score_word(word): Returns len(word) if valid, -2 otherwise.
    - minimax(pool, current_word, is_max): Recursively tries all letter picks.
      Uses a memo dictionary keyed by (remaining pool, current word, whose turn).
    - play_game(letters): Simulates the game, printing each player's pick.
--------------------------------------------------------------------------------

import math

DICTIONARY = {"cat", "bat", "tab", "at", "cab", "bad", "had"}

def score_word(word):
    if word in DICTIONARY:
        return len(word)
    return -2

memo = {}

def minimax(pool, current_word, is_max):
    key = (tuple(pool), current_word, is_max)
    if key in memo:
        return memo[key]
    if not pool:
        result = score_word(current_word)
        memo[key] = result
        return result
    if is_max:
        best = -math.inf
        for i in range(len(pool)):
            new_pool = pool[:i] + pool[i+1:]
            val = minimax(new_pool, current_word + pool[i], False)
            best = max(best, val)
    else:
        best = math.inf
        for i in range(len(pool)):
            new_pool = pool[:i] + pool[i+1:]
            val = minimax(new_pool, current_word + pool[i], True)
            best = min(best, val)
    memo[key] = best
    return best

def play_game(letters):
    pool = letters[:]
    current_word = ""
    is_max = True
    print("Initial Letters:", pool)

    while pool:
        best_index = 0
        best_value = -math.inf if is_max else math.inf
        for i in range(len(pool)):
            letter = pool[i]
            new_pool = pool[:i] + pool[i+1:]
            value = minimax(new_pool, current_word + letter, not is_max)
            if is_max:
                if value > best_value:
                    best_value = value; best_index = i
            else:
                if value < best_value:
                    best_value = value; best_index = i
        chosen_letter = pool.pop(best_index)
        current_word += chosen_letter
        player = "Max" if is_max else "Min"
        print(f"{player} picks '{chosen_letter}', Current Word: {current_word}")
        is_max = not is_max

    final_score = score_word(current_word)
    print(f"\nFinal Word: {current_word}")
    print(f"Score: {final_score}")
    if final_score > 0: print("Winner: Max")
    elif final_score < 0: print("Winner: Min")
    else: print("Draw")

if __name__ == "__main__":
    letters = ['c', 'a', 't']
    play_game(letters)


================================================================================
  SECTION 7 — CHESS AI (MINIMAX + ALPHA-BETA)
================================================================================
  What it does:
    A playable chess game where the human plays White and the AI plays Black.
    The AI uses Minimax with Alpha-Beta pruning to decide its best move.

  Functions:
    - evaluate(board): Calculates a material score (positive = White ahead).
      Piece values: Pawn=100, Knight=320, Bishop=330, Rook=500, Queen=900.
      Also adds +10 bonus for controlling center squares (d4, d5, e4, e5).
    - minimax(board, depth, alpha, beta, maximizing): Standard Alpha-Beta
      Minimax. Calls evaluate() at depth=0 or game over.
    - get_best_move(board, depth): Iterates all legal moves for White, runs
      minimax for each, returns the move with the highest value.
    - play_game(): Main game loop. Human enters moves in UCI format (e.g., e2e4).
  
  Requires: pip install chess
--------------------------------------------------------------------------------

import chess
import math

def evaluate(board):
    piece_values = {
        chess.PAWN: 100, chess.KNIGHT: 320, chess.BISHOP: 330,
        chess.ROOK: 500, chess.QUEEN: 900, chess.KING: 0
    }
    score = 0
    for piece in piece_values:
        score += len(board.pieces(piece, chess.WHITE)) * piece_values[piece]
        score -= len(board.pieces(piece, chess.BLACK)) * piece_values[piece]
    center_squares = [chess.D4, chess.D5, chess.E4, chess.E5]
    for square in center_squares:
        piece = board.piece_at(square)
        if piece:
            if piece.color == chess.WHITE: score += 10
            else: score -= 10
    return score

def minimax(board, depth, alpha, beta, maximizing):
    if depth == 0 or board.is_game_over():
        return evaluate(board)
    if maximizing:
        max_eval = -math.inf
        for move in board.legal_moves:
            board.push(move)
            eval = minimax(board, depth - 1, alpha, beta, False)
            board.pop()
            max_eval = max(max_eval, eval)
            alpha = max(alpha, eval)
            if beta <= alpha: break
        return max_eval
    else:
        min_eval = math.inf
        for move in board.legal_moves:
            board.push(move)
            eval = minimax(board, depth - 1, alpha, beta, True)
            board.pop()
            min_eval = min(min_eval, eval)
            beta = min(beta, eval)
            if beta <= alpha: break
        return min_eval

def get_best_move(board, depth):
    best_move = None
    best_value = -math.inf
    for move in board.legal_moves:
        board.push(move)
        move_value = minimax(board, depth - 1, -math.inf, math.inf, False)
        board.pop()
        if move_value > best_value:
            best_value = move_value
            best_move = move
    return best_move

def play_game():
    board = chess.Board()
    print("=== Chess AI (Minimax + Alpha-Beta) ===")
    print("You are WHITE. Enter moves like: e2e4")
    while not board.is_game_over():
        print(f"\nCurrent Board:\n\n{board}")
        move = input("\nYour move: ")
        try:
            board.push(chess.Move.from_uci(move))
        except:
            print("Invalid move! Try again.")
            continue
        if board.is_game_over(): break
        print("\nAI is thinking...")
        ai_move = get_best_move(board, depth=3)
        print("AI move:", ai_move)
        board.push(ai_move)
    print(f"\nFinal Board:\n\n{board}")
    print(f"\nGame Over! Result: {board.result()}")

if __name__ == "__main__":
    play_game()


================================================================================
  SECTION 8 — CSP: OR-TOOLS BASICS (Variables, Constraints, Solver)
================================================================================
  What it does:
    The simplest OR-Tools CP-SAT example. Defines three integer variables
    (x, y, z) in domain [0, 2] and enforces x != y. Then solves and prints
    all solutions.

  Key OR-Tools concepts:
    - cp_model.CpModel(): Creates the constraint model.
    - model.NewIntVar(lb, ub, name): Creates an integer variable in [lb, ub].
    - model.Add(constraint): Adds a constraint to the model.
    - cp_model.CpSolver(): The solver that processes the model.
    - cp_model.VarArraySolutionPrinter([vars]): Callback that prints each
      solution found. Pass to solver.Solve() to enumerate all solutions.
    - solver.parameters.enumerate_all_solutions = True: Find every solution.
--------------------------------------------------------------------------------

from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Variables: x, y, z each in domain {0, 1, 2}
num_vals = 3
x = model.NewIntVar(0, num_vals - 1, "x")
y = model.NewIntVar(0, num_vals - 1, "y")
z = model.NewIntVar(0, num_vals - 1, "z")

# Constraint: x and y must be different
model.Add(x != y)

# Solve and print all solutions
solver = cp_model.CpSolver()
solution_printer = cp_model.VarArraySolutionPrinter([x, y, z])
solver.parameters.enumerate_all_solutions = True
solver.Solve(model, solution_printer)


================================================================================
  SECTION 9 — CSP: ALL SOLUTIONS FINDER
================================================================================
  What it does:
    Finds ALL valid assignments for three variables a, b, c in {1, 2, 3}
    such that all three have different values. Also shows the status codes.

  Key addition over Section 8:
    - model.AddAllDifferent([a, b, c]): Shorthand for a!=b, b!=c, a!=c.
    - Status codes: OPTIMAL, FEASIBLE, INFEASIBLE, UNKNOWN are printed to
      understand what the solver result means.
--------------------------------------------------------------------------------

from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Variables in domain {1, 2, 3}
a = model.NewIntVar(1, 3, 'a')
b = model.NewIntVar(1, 3, 'b')
c = model.NewIntVar(1, 3, 'c')

# All three must have different values
model.Add(a != b)
model.Add(b != c)
model.Add(a != c)

solver = cp_model.CpSolver()
solution_printer = cp_model.VarArraySolutionPrinter([a, b, c])
solver.parameters.enumerate_all_solutions = True
solver.Solve(model, solution_printer)

print("optimal",     cp_model.OPTIMAL)
print("Feasible",    cp_model.FEASIBLE)

================================================================================
  SECTION 38 — ML: ATTRITION PREPROCESSING PIPELINE
================================================================================
  What it does:
    A complete preprocessing pipeline for attrition data, covering missing
    values, outlier treatment, feature engineering, encoding, scaling, and
    class imbalance correction.

  Functions:
    - handle_missing(df): Fills categorical columns with mode, numeric with median.
    - treat_outliers(df, columns): Caps outliers using IQR method (replaces
      values outside [Q1-1.5*IQR, Q3+1.5*IQR] with the boundary value).
    - engineer_features(df): Creates IncomePerYear (monthly*12),
      SatisfactionScore (mean of two satisfaction columns), LongTenure (1 if
      YearsAtCompany > 10, else 0).

  After pipeline:
    - LabelEncoder: Converts binary categorical (Attrition Yes/No) to 0/1.
    - get_dummies: One-hot encodes remaining categoricals.
    - StandardScaler: Scales selected numeric columns.
    - RandomOverSampler: Resamples minority class to fix class imbalance.
    - Correlation heatmap of final processed data.
  
  Requires: pip install imbalanced-learn
--------------------------------------------------------------------------------

import pandas as pd, numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from imblearn.over_sampling import RandomOverSampler

def handle_missing(df):
    for col in df.columns:
        if df[col].dtype == 'object':
            df[col] = df[col].fillna(df[col].mode()[0])
        else:
            df[col] = df[col].fillna(df[col].median())
    return df

def treat_outliers(df, columns):
    for col in columns:
        Q1, Q3 = df[col].quantile(0.25), df[col].quantile(0.75)
        IQR = Q3 - Q1; upper = Q3 + 1.5*IQR; lower = Q1 - 1.5*IQR
        df[col] = np.where(df[col] > upper, upper,
                  np.where(df[col] < lower, lower, df[col]))
    return df

def engineer_features(df):
    df['IncomePerYear']    = df['MonthlyIncome'] * 12
    df['SatisfactionScore']= df[['JobSatisfaction','EnvironmentSatisfaction']].mean(axis=1)
    df['LongTenure']       = (df['YearsAtCompany'] > 10).astype(int)
    return df

df = pd.read_csv('attrition.csv')
df = handle_missing(df)
df = engineer_features(df)
df = treat_outliers(df, ['MonthlyIncome','DistanceFromHome','YearsAtCompany'])


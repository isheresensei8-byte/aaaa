    print(f"{name:<20} | {mae:<10.2f} | {rmse:<10.2f} | {r2:<10.4f}")

best_model_name = max(results, key=lambda k: results[k]["CV_R2_Mean"])
best_model = results[best_model_name]["Model"]
y_pred_best = best_model.predict(X_test)


      "            at_least_3_rainy += 1",
      "",
      "    prob = (at_least_3_rainy / iterations) * 100",
      "    print(f\"\\nProbability of at least 3 rainy days: {prob:.2f}%\")",
      "",
      "if __name__ == '__main__':",
      "    solve_weather_markov()"
    ],

  "University Course Timetabling Snippet": {
    "prefix": "L7 CSP Course Time tabling",
    "body": [
      "from ortools.sat.python import cp_model",
      "",
      "def solve_course_timetabling():",
      "    model = cp_model.CpModel()",
      "",
      "    # --- Data ---",
      "    courses = ['CS101', 'CS102', 'AI201', 'DS202', 'SE301', 'ML401']",
      "    enrollment = {",
      "        'CS101': 35, 'CS102': 50, 'AI201': 45, ",
      "        'DS202': 60, 'SE301': 30, 'ML401': 80",
      "    }",
      "    ",
      "    # Room indices: 0:R1(40), 1:R2(60), 2:R3(100)",
      "    rooms = ['R1', 'R2', 'R3']",
      "    room_capacities = [40, 60, 100]",
      "    time_slots = [1, 2, 3, 4]",
      "",
      "    # Conflict pairs (cannot be at the same time)",
      "    conflicts = [",
      "        ('CS101', 'CS102'), ('CS102', 'AI201'), ",
      "        ('AI201', 'ML401'), ('DS202', 'SE301')",
      "    ]",
      "",
      "    # --- Variables ---",
      "    # timeslot[c] in {1, 2, 3, 4}",
      "    timeslot = {c: model.NewIntVar(1, 4, f'timeslot_{c}') for c in courses}",
      "    # room_idx[c] in {0, 1, 2} corresponding to R1, R2, R3",
      "    room_idx = {c: model.NewIntVar(0, 2, f'room_{c}') for c in courses}",
      "",
      "    # --- Constraints ---",
      "",
      "    # 1. Conflicting courses must not be in the same time slot",
      "    for c1, c2 in conflicts:",
      "        model.Add(timeslot[c1] != timeslot[c2])",
      "",
      "    # 2. Room capacity constraint",
      "    for c in courses:",
      "        # Create a list of boolean literals for room assignment",
      "        room_literals = []",
      "        for r in range(len(rooms)):",
      "            lit = model.NewBoolVar(f'{c}_is_in_{rooms[r]}')",
      "            model.Add(room_idx[c] == r).OnlyEnforceIf(lit)",
      "            model.Add(room_idx[c] != r).OnlyEnforceIf(lit.Not())",
      "            room_literals.append(lit)",
      "            ",
      "            # If room capacity is less than enrollment, that room cannot be picked",
      "            if room_capacities[r] < enrollment[c]:",
      "                model.Add(lit == 0)",
      "        ",
      "        # Each course must have exactly one room",
      "        model.AddExactlyOne(room_literals)",
      "",
      "    # 3. No two courses in the same room at the same time",
      "    for i in range(len(courses)):",
      "        for j in range(i + 1, len(courses)):",
      "            c1, c2 = courses[i], courses[j]",
      "            # If (same time) then (different room)",
      "            same_time = model.NewBoolVar(f'{c1}_{c2}_same_time')",
      "            model.Add(timeslot[c1] == timeslot[c2]).OnlyEnforceIf(same_time)",
      "            model.Add(timeslot[c1] != timeslot[c2]).OnlyEnforceIf(same_time.Not())",
      "            ",
      "            model.Add(room_idx[c1] != room_idx[c2]).OnlyEnforceIf(same_time)",
      "",
      "    # 4. Special Slot Constraints",
      "    # ML401 in slots 3 or 4",
      "    model.Add(timeslot['ML401'] >= 3)",
      "    # DS202 in slots 1 or 2",
      "    model.Add(timeslot['DS202'] <= 2)",
      "",
      "    # --- Solver ---",
      "    solver = cp_model.CpSolver()",
      "    status = solver.Solve(model)",
      "",
      "    if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:",
      "        print(f'{\"Course\":<10} | {\"Time Slot\":<10} | {\"Room\":<10} | {\"Students\":<10}')",
      "        print('-' * 50)",
      "        for c in courses:",
      "            t = solver.Value(timeslot[c])",
      "            r = rooms[solver.Value(room_idx[c])]",
      "            print(f'{c:<10} | {t:<10} | {r:<10} | {enrollment[c]:<10}')",
      "    else:",
      "        print('No feasible timetable found.')",
      "",
      "if __name__ == '__main__':",
      "    solve_course_timetabling()"
    ],
    "description": "OR-Tools CSP solution for course scheduling with capacity, conflict, and time-slot constraints."
  },
  "Logistics Vehicle Assignment Snippet": {
    "prefix": "L7 CSP Vehicle Assignment",
    "body": [
      "from ortools.sat.python import cp_model",
      "",
      "def solve_vehicle_assignment():",
      "    model = cp_model.CpModel()",
      "",
      "    # --- Data ---",
      "    locations = ['L1', 'L2', 'L3', 'L4', 'L5']",
      "    vehicles = ['V1', 'V2', 'V3']",
      "    # Vehicle indices: 0:V1, 1:V2, 2:V3",
      "",
      "    # --- Variables ---",
      "    # assignment[loc] = vehicle_index",
      "    assignment = {loc: model.NewIntVar(0, 2, f'assign_{loc}') for loc in locations}",
      "",
      "    # --- Constraints ---",
      "",
      "    # 1. Vehicle Capacity Constraints",
      "    # V1 and V2: at most 2. V3: at most 3.",
      "    for v_idx, capacity in [(0, 2), (1, 2), (2, 3)]:",
      "        # Count how many locations are assigned to this vehicle index",
      "        count_vars = []",
      "        for loc in locations:",
      "            is_assigned = model.NewBoolVar(f'{loc}_to_V{v_idx+1}')",
      "            model.Add(assignment[loc] == v_idx).OnlyEnforceIf(is_assigned)",
      "            model.Add(assignment[loc] != v_idx).OnlyEnforceIf(is_assigned.Not())",
      "            count_vars.append(is_assigned)",
      "        model.Add(sum(count_vars) <= capacity)",
      "",
      "    # 2. Specific Location Constraints",
      "    # L1 and L2 cannot be in the same vehicle",
      "    model.Add(assignment['L1'] != assignment['L2'])",
      "    # L3 must be assigned to vehicle V3 (index 2)",
      "    model.Add(assignment['L3'] == 2)",
      "",
      "    # 3. Workload Fairness (V1 vs V2)",
      "    # |Count(V1) - Count(V2)| <= 1",
      "    v1_count = model.NewIntVar(0, 5, 'v1_count')",
      "    v2_count = model.NewIntVar(0, 5, 'v2_count')",
      "    ",
      "    v1_indicators = [model.NewBoolVar(f'L{i}_is_V1') for i in range(1, 6)]",
      "    v2_indicators = [model.NewBoolVar(f'L{i}_is_V2') for i in range(1, 6)]",
      "    ",
      "    for i, loc in enumerate(locations):",
      "        model.Add(assignment[loc] == 0).OnlyEnforceIf(v1_indicators[i])",
      "        model.Add(assignment[loc] != 0).OnlyEnforceIf(v1_indicators[i].Not())",
      "        model.Add(assignment[loc] == 1).OnlyEnforceIf(v2_indicators[i])",
      "        model.Add(assignment[loc] != 1).OnlyEnforceIf(v2_indicators[i].Not())",
      "    ",
      "    model.Add(v1_count == sum(v1_indicators))",
      "    model.Add(v2_count == sum(v2_indicators))",
      "    ",
      "    # Absolute difference constraint: -1 <= v1_count - v2_count <= 1",
      "    model.Add(v1_count - v2_count <= 1)",
      "    model.Add(v1_count - v2_count >= -1)",
      "",
      "    # 4. Dependency Constraint",
      "    # If L4 is assigned to V1, then L5 must be assigned to V1",
      "    l4_is_v1 = model.NewBoolVar('l4_is_v1')",
      "    l5_is_v1 = model.NewBoolVar('l5_is_v1')",
      "    model.Add(assignment['L4'] == 0).OnlyEnforceIf(l4_is_v1)",
      "    model.Add(assignment['L4'] != 0).OnlyEnforceIf(l4_is_v1.Not())",
      "    model.Add(assignment['L5'] == 0).OnlyEnforceIf(l5_is_v1)",
      "    model.Add(assignment['L5'] != 0).OnlyEnforceIf(l5_is_v1.Not())",
      "    ",
      "    model.AddImplication(l4_is_v1, l5_is_v1)",
      "",
      "    # --- Solver ---",
      "    solver = cp_model.CpSolver()",
      "    status = solver.Solve(model)",
      "",
      "    if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:",
      "        print(\"Vehicle Assignment Plan:\")",
      "        print(\"-\" * 25)",
      "        for loc in locations:",
      "            v_idx = solver.Value(assignment[loc])",
      "            print(f\"{loc} -> {vehicles[v_idx]}\")",
      "        print(\"-\" * 25)",
      "        print(f\"V1 Total: {solver.Value(v1_count)}\")",
      "        print(f\"V2 Total: {solver.Value(v2_count)}\")",
      "    else:",
      "        print(\"No feasible assignment found.\")",
      "",
      "if __name__ == \"__main__\":",
      "    solve_vehicle_assignment()"
    ],
    "description": "Logistics Vehicle Assignment CSP using OR-Tools, incorporating capacity, implication, and balancing constraints."
  },

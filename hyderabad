  "Course Examination Scheduling CSP": {
    "prefix": "Prac CSP Course Exam",
    "body": [
      "from ortools.sat.python import cp_model",
      "",
      "def solve_exam_assignment():",
      "    # 1. Initialize the Model",
      "    model = cp_model.CpModel()",
      "",
      "    # 2. Define Variables",
      "    # 8 courses (C0-C7), each can be in Slot 0, 1, or 2",
      "    num_courses = 8",
      "    num_slots = 3",
      "    courses = [model.NewIntVar(0, num_slots - 1, f'C{i}') for i in range(num_courses)]",
      "",
      "    # 3. Add Constraints",
      "    ",
      "    # Constraint: No time slot can have more than 4 courses",
      "    for slot in range(num_slots):",
      "        count_in_slot = []",
      "        for c in range(num_courses):",
      "            is_in_slot = model.NewBoolVar(f'C{c}_in_slot_{slot}')",
      "            model.Add(courses[c] == slot).OnlyEnforceIf(is_in_slot)",
      "            model.Add(courses[c] != slot).OnlyEnforceIf(is_in_slot.Not())",
      "            count_in_slot.append(is_in_slot)",
      "        model.Add(sum(count_in_slot) <= 4)",
      "",
      "    # Constraint: C0 and C1 cannot be in the same slot",
      "    model.Add(courses[0] != courses[1])",
      "",
      "    # Constraint: C2 and C3 must be in the same slot",
      "    model.Add(courses[2] == courses[3])",
      "",
      "    # Constraint: C4 and C5 must be in different slots",
      "    model.Add(courses[4] != courses[5])",
      "",
      "    # Constraint: C6 and C7 must be in the same slot",
      "    model.Add(courses[6] == courses[7])",
      "",
      "    # Constraint: C1 and C6 cannot be in the same slot",
      "    model.Add(courses[1] != courses[6])",
      "",
      "    # Constraint: C5 is not allowed in Slot 0",
      "    model.Add(courses[5] != 0)",
      "",
      "    # 4. Initialize Solver and Solve",
      "    solver = cp_model.CpSolver()",
      "    status = solver.Solve(model)",
      "",
      "    # 5. Output Results",
      "    if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:",
      "        print(\"Final Examination Schedule:\")",
      "        for i in range(num_courses):",
      "            print(f\"Course C{i} is assigned to Slot {solver.Value(courses[i])}\")",
      "        ",
      "        # Verify counts per slot",
      "        print(\"\\nSlot Summary:\")",
      "        for s in range(num_slots):",
      "            assigned = [f'C{i}' for i in range(num_courses) if solver.Value(courses[i]) == s]",
      "            print(f\"Slot {s}: {len(assigned)} courses ({', '.join(assigned)})\")",
      "    else:",
      "        print(\"No feasible solution found.\")",
      "",
      "if __name__ == '__main__':",
      "    solve_exam_assignment()"

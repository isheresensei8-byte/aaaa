      "import numpy as np",
      "",
      "def solve_weather_markov():",
      "    # 1. Define states and transition matrix",
      "    # Index mapping: 0: Sunny, 1: Cloudy, 2: Rainy",
      "    states = ['Sunny', 'Cloudy', 'Rainy']",
      "    ",
      "    # transition_matrix[i][j] is the probability of moving from state i to state j",
      "    transition_matrix = np.array([",
      "        [0.7, 0.2, 0.1],  # From Sunny: 70% stay, 20% cloud, 10% rain",
      "        [0.3, 0.4, 0.3],  # From Cloudy: 30% sun, 40% stay, 30% rain",
      "        [0.2, 0.3, 0.5]   # From Rainy: 20% sun, 30% cloud, 50% stay",
      "    ])",
      "",
      "    def simulate_weather(start_state, days):",
      "        current_state_idx = states.index(start_state)",
      "        sequence = [start_state]",
      "        for _ in range(days - 1):",
      "            current_state_idx = np.random.choice(",
      "                [0, 1, 2], ",
      "                p=transition_matrix[current_state_idx]",
      "            )",
      "            sequence.append(states[current_state_idx])",
      "        return sequence",
      "",
      "    # 2. Simulate the weather for the next 10 days starting with Sunny",
      "    days_to_simulate = 10",
      "    initial_day = 'Sunny'",
      "    forecast = simulate_weather(initial_day, days_to_simulate)",
      "    print(f\"10-Day Forecast: {' -> '.join(forecast)}\")",
      "",
      "    # 3. Calculate Probability of >= 3 rainy days using Monte Carlo (10,000 runs)",
      "    iterations = 10000",
      "    at_least_3_rainy = 0",

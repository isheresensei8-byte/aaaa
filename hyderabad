      "    # 1. Conflict Constraints (Cannot be in the same slot)",
      "    # Math vs Physics, AI vs OS, OS vs DB",
      "    model.Add(exam['Math'] != exam['Physics'])",
      "    model.Add(exam['AI'] != exam['OS'])",
      "    model.Add(exam['OS'] != exam['DB'])",
      "",
      "    # 2. Daily Capacity Constraint (Max 2 exams per day)",
      "    for day_slots in [[1, 2], [3, 4], [5, 6]]:",
      "        exams_on_day = []",
      "        for s in subjects:",
      "            is_on_day = model.NewBoolVar(f'{s}_on_day_{day_slots}')",
      "            # Link boolean to whether the exam slot is in the day's slot list",
      "            model.AddAllowedAssignments([exam[s]], [(slot,) for slot in day_slots]).OnlyEnforceIf(is_on_day)",
      "            model.AddForbiddenAssignments([exam[s]], [(slot,) for slot in day_slots]).OnlyEnforceIf(is_on_day.Not())",
      "            exams_on_day.append(is_on_day)",
      "        model.Add(sum(exams_on_day) <= 2)",
      "",
      "    # 3. Minimum Gap Constraint (At least 2 slots between AI and OS)",
      "    # This implies |AI - OS| >= 2",
      "    diff_ai_os = model.NewIntVar(0, 6, 'diff_ai_os')",
      "    model.AddAbsEquality(diff_ai_os, exam['AI'] - exam['OS'])",
      "    model.Add(diff_ai_os >= 2)",
      "",
      "    # 4. Ordering Constraint (Math before DB)",
      "    model.Add(exam['Math'] < exam['DB'])",
      "",
      "    # 5. Slot Capacity (Max 2 exams per slot)",
      "    for slot in slots:",

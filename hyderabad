      "from ortools.sat.python import cp_model",
      "",
      "def solve_exam_schedule_nuces():",
      "    model = cp_model.CpModel()",
      "",
      "    # ---------------- DATA ----------------",
      "    courses = ['OOP', 'DSA', 'AI', 'DBMS', 'CN', 'SE']",
      "",
      "    rooms = ['R1', 'R2', 'R3']",
      "    times = ['Morning', 'Noon', 'Evening']",
      "",
      "    # Encoding",
      "    room_id = {r: i for i, r in enumerate(rooms)}",
      "    time_id = {t: i for i, t in enumerate(times)}",
      "",
      "    # ---------------- VARIABLES ----------------",
      "    room = {c: model.NewIntVar(0, 2, f'room_{c}') for c in courses}",
      "    time = {c: model.NewIntVar(0, 2, f'time_{c}') for c in courses}",
      "",
      "    # ---------------- DOMAIN CONSTRAINTS ----------------",
      "",
      "    # OOP cannot be in R3",
      "    model.Add(room['OOP'] != 2)",
      "",
      "    # AI must be R1 or R2",
      "    model.Add(room['AI'] != 2)",
      "",
      "    # CN cannot be Evening",
      "    model.Add(time['CN'] != 2)",
      "",
      "    # DBMS must be Morning",
      "    model.Add(time['DBMS'] == 0)",
      "",
      "    # ---------------- GLOBAL CONSTRAINT ----------------",
      "",
      "    # No two courses in same room AND same time",
      "    for i in range(len(courses)):",
      "        for j in range(i + 1, len(courses)):",
      "            c1, c2 = courses[i], courses[j]",
      "",
      "            same_room_time = model.NewBoolVar(f'{c1}_{c2}_conflict')",
      "",
      "            model.Add(room[c1] == room[c2]).OnlyEnforceIf(same_room_time)",
      "            model.Add(time[c1] == time[c2]).OnlyEnforceIf(same_room_time)",
      "            model.Add(room[c1] != room[c2]).OnlyEnforceIf(same_room_time.Not())",
      "            model.Add(time[c1] != time[c2]).OnlyEnforceIf(same_room_time.Not())",
      "",
      "    # ---------------- CONDITIONAL CONSTRAINTS ----------------",
      "",
      "    # C1: If DSA in R1 → OOP must be Morning",
      "    dsa_r1 = model.NewBoolVar('dsa_r1')",
      "    model.Add(room['DSA'] == 0).OnlyEnforceIf(dsa_r1)",
      "    model.Add(room['DSA'] != 0).OnlyEnforceIf(dsa_r1.Not())",
      "",
      "    model.Add(time['OOP'] == 0).OnlyEnforceIf(dsa_r1)",
      "",
      "    # C2: If SE not Noon → CN must be Noon",
      "    se_not_noon = model.NewBoolVar('se_not_noon')",
      "    model.Add(time['SE'] != 1).OnlyEnforceIf(se_not_noon)",
      "    model.Add(time['SE'] == 1).OnlyEnforceIf(se_not_noon.Not())",
      "",
      "    model.Add(time['CN'] == 1).OnlyEnforceIf(se_not_noon)",
      "",
      "    # C3: AI-dependent DBMS rule",
      "    ai_evening = model.NewBoolVar('ai_evening')",
      "    model.Add(time['AI'] == 2).OnlyEnforceIf(ai_evening)",
      "    model.Add(time['AI'] != 2).OnlyEnforceIf(ai_evening.Not())",

      "\t${3:z} = model.NewIntVar(0, 10, '${3:z}')",
      "\t",
      "\t# --- 2. CONSTRAINTS ---",
      "",
      "\t# A. Uniqueness (No two variables share the same value)",
      "\tmodel.AddAllDifferent([${1:x}, ${2:y}, ${3:z}])",
      "",
      "\t# B. Arithmetic (Precedence or Fixed Gaps)",
      "\tmodel.Add(${1:x} < ${2:y}) ",
      "\tmodel.Add(${2:y} == ${3:z} + ${4:2})",
      "",
      "\t# C. Domain Restriction",
      "\tmodel.AddOneOf(${1:x}, [1, 3, 5]) ",
      "\tmodel.Add(${2:y} != 2)",
      "",
      "\t# D. Logical Constraints (Boolean Implications)",
      "\tb1 = model.NewBoolVar('b1')",
      "\tmodel.Add(${1:x} == 3).OnlyEnforceIf(b1)",
      "\t",
      "\tmodel.AddBoolOr([b1]) # Add more bool vars to the list for OR logic",
      "",
      "\t# E. Absolute Distance",
      "\tdiff = model.NewIntVar(0, 10, 'diff')",
      "\tmodel.AddAbsEquality(diff, ${1:x} - ${2:y})",
      "\tmodel.Add(diff == 1)",
      "",
      "\t# --- 3. SOLVER ---",
      "\tsolver = cp_model.CpSolver()",
      "\tstatus = solver.Solve(model)",
      "",
      "\tif status in (cp_model.OPTIMAL, cp_model.FEASIBLE):",
      "\t\tprint(f\"${1:x}: {solver.Value(${1:x})}, ${2:y}: {solver.Value(${2:y})}, ${3:z}: {solver.Value(${3:z})}\")",
      "\telse:",
      "\t\tprint(\"No solution found.\")",
      "",
      "if __name__ == \"__main__\":",
      "\tsolve_universal_csp()"
    ],
    "description": "Template for complex OR-Tools Constraint Programming (CSP) models."
  },

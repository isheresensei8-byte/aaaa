      "# 8. HANDLING MISSING VALUES",
      "def handle_missing(df):",
      "\tfor col in df.columns:",
      "\t\tif df[col].dtype == 'object':",
      "\t\t\tdf[col] = df[col].fillna(df[col].mode()[0])",
      "\t\telse:",
      "\t\t\tdf[col] = df[col].fillna(df[col].median())",
      "\treturn df",
      "",
      "# 12. OUTLIER TREATMENT (Capping)",
      "def treat_outliers(df, columns):",
      "\tfor col in columns:",
      "\t\tQ1, Q3 = df[col].quantile(0.25), df[col].quantile(0.75)",
      "\t\tIQR = Q3 - Q1",
      "\t\tupper, lower = Q3 + 1.5 * IQR, Q1 - 1.5 * IQR",
      "\t\tdf[col] = np.where(df[col] > upper, upper, np.where(df[col] < lower, lower, df[col]))",
      "\treturn df",
      "",
      "# 13. FEATURE ENGINEERING",
      "def engineer_features(df):",
      "\tdf['IncomePerYear'] = df['MonthlyIncome'] * 12",
